{
  "name": "mywedding",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "local:harden": "node scripts/local-supabase.mjs harden",
    "local:up": "node scripts/local-supabase.mjs up",
    "local:down": "node scripts/local-supabase.mjs down",
    "local:check": "node scripts/local-supabase.mjs check",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "preview": "node scripts/preview-static.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
